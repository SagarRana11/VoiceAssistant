PORT=5000
NODE_ENV=development

# MongoDB — replace with your Atlas URI or local URI
MONGODB_URI=mongodb://localhost:27017/voice-assistant

# JWT — use a long random string in production
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# OpenAI — leave empty to use built-in mock responses
OPENAI_API_KEY=

# ── CodeWriter (autonomous coding agent) ──────────────────────────────
# Anthropic key for the default Claude provider — leave empty to use mock loop
ANTHROPIC_API_KEY=
# Default model (claude* → Claude adapter, otherwise OpenAI adapter)
CODEWRITER_MODEL=claude-sonnet-5
# Max tool-use iterations per task run
CODEWRITER_MAX_ITERS=25

# HeyGen Streaming — leave empty to disable
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=Anna_public_3_20240108

# D-ID Streaming — leave empty to use built-in avatar fallback
DID_API_KEY=
DID_PRESENTER_URL=https://d-id-public-bucket.s3.amazonaws.com/alice.jpg

# Frontend URL for CORS
CLIENT_URL=http://localhost:3000
